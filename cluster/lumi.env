# LUMI-G (standard-g, 8 GCDs) — source via setup_lumi_env.sh / simclr.sbatch
CLUSTER_NAME=lumi

PROJECT_ROOT=/project/project_465003400/SSLHydra
SIF=/appl/local/laifs/containers/lumi-multitorch-latest.sif
VENV_PATH=/scratch/project_465003400/cache/SSLHydra-venv

DATA_ROOT=/scratch/project_465003400/datasets
IMAGENET_ROOT="${IMAGENET_ROOT:-/scratch/project_465003400/datasets/IN1K}"
# Per corruption/severity LMDB. Do not extract the 3.75e6 JPEGs onto scratch.
IMAGENET_C_ROOT="${IMAGENET_C_ROOT:-/scratch/project_465003400/datasets/IN1K-C-lmdb}"
IMAGENET_SQSH="${IMAGENET_SQSH:-/scratch/project_465003400/datasets/IN1K-jpeg.sqsh}"
IMAGENET_LMDB="${IMAGENET_LMDB:-/scratch/project_465003400/datasets/IN1K-lmdb}"
HF_IN1K_CACHE="${HF_IN1K_CACHE:-/scratch/project_465003400/cache/huggingface/datasets--ILSVRC--imagenet-1k}"
FFCV_TRAIN=${FFCV_TRAIN:-/scratch/project_465003400/datasets/ffcv/IN1K_train_smart500_q90.ffcv}
FFCV_VAL=${FFCV_VAL:-/scratch/project_465003400/datasets/ffcv/IN1K_val_smart500_q90.ffcv}
SCRATCH_ROOT=/scratch/project_465003400/SSLHydra
OUTPUT_ROOT=/scratch/project_465003400/SSLHydra/outputs
JOB_TMP_BASE=/scratch/project_465003400/SSLHydra/tmp
PIP_CACHE_DIR=/scratch/project_465003400/cache/pip

HF_HOME=/scratch/project_465003400/cache/huggingface
TORCH_HOME=/scratch/project_465003400/cache/torch
XDG_CACHE_HOME=/scratch/project_465003400/cache/xdg
# Persistent MIOpen Find DB. Jobs stage this onto node-local /tmp (Lustre cannot lock).
MIOPEN_CACHE="${MIOPEN_CACHE:-/scratch/project_465003400/cache/miopen}"

SBATCH_ACCOUNT=project_465003400
SBATCH_PARTITION=standard-g
SBATCH_NODES=1
SBATCH_GPUS_PER_NODE=8
SBATCH_CPUS_PER_TASK=56
SBATCH_MEM=480G

WANDB_MODE="${WANDB_MODE:-online}"
WANDB_ENTITY="${WANDB_ENTITY:-erow}"
WANDB_PROJECT="${WANDB_PROJECT:-SSLHydra}"
